--- a/scripts/colors/modules/05-niri.sh
+++ b/scripts/colors/modules/05-niri.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+# iNiR color module: Niri focus-ring through the Rust inir-theme binary.
+set -euo pipefail
+
+source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/module-runtime.sh"
+COLOR_MODULE_ID="niri"
+
+BIN="$HOME/.local/bin/inir-theme"
+[[ -x "$BIN" ]] || exit 0
+
+if "$BIN" apply --target niri >> "$STATE_DIR/user/generated/theming_modules.log" 2>&1; then
+  log_module "focus-ring synced (Rust)"
+else
+  log_module "focus-ring Rust sync failed"
+fi

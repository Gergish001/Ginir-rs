+  if (!strcmp(label, "Display Manager")) return "󰍹";
+  if (!strcmp(label, "Swap")) return "󰓅";
+  if (!strcmp(label, "IP") || !strcmp(label, "Network")) return "󰩟";
+  if (!strncmp(label, "Battery", 7)) return "󰁹";
+  if (!strcmp(label, "Locale")) return "󰗊";
+  if (!strcmp(label, "Theme")) return "󰏘";
+  if (!strcmp(label, "Icons")) return "󰀻";
+  if (!strcmp(label, "Font")) return "󰛖";
+  if (!strcmp(label, "Cursor")) return "󰆿";
+  if (!strcmp(label, "Power Profile")) return "󰚥";
+  if (!strcmp(label, "Colors")) return "";
+  return "";
